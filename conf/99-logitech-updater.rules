# # Rally TableHub device rule.
# SUBSYSTEM=="usb", ACTION=="add", ATTR{idVendor}=="046d", \
#   ATTR{idProduct}=="088f"

# Rally Mic rule for unique ALSA id.
SUBSYSTEM=="sound", ACTION=="add", ATTRS{idVendor}=="046d", \
  ATTRS{idProduct}=="0885", ATTR{id}="RallyMic"
