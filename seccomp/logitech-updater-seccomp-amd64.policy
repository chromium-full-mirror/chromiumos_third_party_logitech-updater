access: 1
arch_prctl: 1
brk: 1
close: 1
connect: 1
execve: 1
exit_group: 1
# fcntl: arg1 == F_SETLK
fcntl: arg1 == 6
fstat: 1
futex: 1
getdents: 1
getdents64: 1
getrlimit: 1
# ioctl: arg1 == TCGETS || arg1 == UVCIOC_CTRL_QUERY ||
#        arg1 == VIDIOC_QUERYCAP || arg1 == HIDIOCSFEATURE(5) ||
#        arg1 == HIDIOCGFEATURE(5) || arg1 == HIDIOCSFEATURE(6) ||
#        arg1 == HIDIOCGFEATURE(6) || arg1 == HIDIOCSFEATURE(40 ||
#        arg1 == HIDIOCGFEATURE(40) ||arg1 == HIDIOCSFEATURE(64) ||
#        arg1 == HIDIOCGFEATURE(64) || arg1 == HIDIOCSFEATURE(66) ||
#        arg1 == HIDIOCGFEATURE(66) || arg1 == HIDIOCSFEATURE(141) ||
#        arg1 == HIDIOCGFEATURE(141) || arg1 == USBDEVFS_RESET
ioctl: arg1 == 0x5401 || arg1 == 0xC0107521 || arg1 == 0x80685600 || arg1 == 0xC0054806 || arg1 == 0xC0054807 || arg1 == 0xC0064806 || arg1 == 0xC0064807 || arg1 == 0xC0284806 || arg1 == 0xC0284807 || arg1 == 0xC0404806 || arg1 == 0xC0404807 || arg1 == 0xC0424806 || arg1 == 0xC0424807 || arg1 == 0xC08D4806 || arg1 == 0xC08D4807 || arg1 == 0x5514
lseek: 1
mmap: 1
mprotect: 1
munmap: 1
nanosleep: 1
open: 1
read: 1
readlink: 1
rt_sigaction: 1
rt_sigprocmask: 1
sendto: 1
set_robust_list: 1
set_tid_address: 1
# socket: arg0 == PFLOCAL
socket: arg0 == 1
stat: 1
write: 1
